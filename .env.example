# =============================================
# WordPress 설정
# =============================================
WP_SITE_URL=https://your-blog.com
# WP REST API는 기본 활성화 (인증 불필요, 공개 글 기준)
# 비공개 글도 가져오려면 Application Password 사용:
# WP_USERNAME=your_wp_username
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# =============================================
# Instagram / Meta Graph API 설정
# Meta Developer Console에서 발급:
# https://developers.facebook.com
# =============================================
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token

# =============================================
# Claude API (글 요약용)
# https://console.anthropic.com
# =============================================
ANTHROPIC_API_KEY=your_anthropic_api_key

# =============================================
# 동작 설정
# =============================================
# 몇 시간마다 새 글 확인할지 (기본: 6시간)
CHECK_INTERVAL_HOURS=6
# 인스타그램 캡션 최대 글자수 (최대 2200)
CAPTION_MAX_LENGTH=2000
# 해시태그 (공백으로 구분)
HASHTAGS=#블로그 #정보공유
# 블로그 링크를 바이오에 안내하는 문구
BLOG_LINK_TEXT=🔗 블로그 링크는 프로필 바이오에!
